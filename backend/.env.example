# OTP Email - Gmail (primary) or Resend (fallback when Gmail blocked)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PWD=your-16-char-app-password

# Fallback when Gmail SMTP blocked - get key at resend.com/api-keys
# RESEND_KEY=re_your_key

# Email allowed for password reset
RESET_EMAIL=your-email@gmail.com