# OTP email only. This is not the weekly shop-report SMTP.
# Copy this file to backend/.env and fill the real values there.
# Never commit backend/.env.

# Gmail that sends the admin-password OTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PWD=your-16-char-app-password

# Optional. Used only if Gmail OTP fails.
# RESEND_KEY=re_your_key
# RESEND_FROM=noreply@yourdomain.com

# The only address allowed to receive the admin-password OTP.
# Must match FORGOT_PASSWORD_EMAIL in frontend/src/constants/adminAuth.ts
RESET_EMAIL=oliyaruviprinters@gmail.com
